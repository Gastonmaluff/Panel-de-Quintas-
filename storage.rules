rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /venues/{venueId}/content/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
